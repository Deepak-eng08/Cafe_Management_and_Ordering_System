# Copy to .env and fill in your real values. Never commit the real .env.

# Server
PORT=5000

# MongoDB connection string (REQUIRED — the server refuses to start without it).
# Use your MongoDB Atlas URI, e.g.:
#   MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/cafe?retryWrites=true&w=majority
# Seeding is a separate, manual step: `npm run seed` (never runs on server start).

# Admin login (server-side JWT auth). Never expose these via VITE_ variables.
ADMIN_USERNAME=cafeadmin
ADMIN_PASSWORD=change-me
JWT_SECRET=use-a-long-random-secret

# Cloudinary (image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Production settings
# Set to true only when running behind a reverse proxy (Nginx, Render, Railway, etc.)
TRUST_PROXY=false
# Comma-separated list of allowed frontend origins. Leave empty to allow all (dev).
# Example: ALLOWED_ORIGINS=https://cafe.example.com,https://admin.example.com
# ALLOWED_ORIGINS=
